# Copy to .env for local development. On EC2 these come from the container environment.

# local = Anvil on 127.0.0.1:8545, sepolia = Ethereum Sepolia
CHAIN=local

# Alchemy Sepolia HTTPS URL in production; defaults to the local Anvil URL when CHAIN=local
RPC_URL=

# From contracts/deployments/<chainId>.json
BADGE_ADDRESS=
BADGE_START_BLOCK=0

PORT=3001
DATABASE_PATH=./data/loyl.db

# Comma separated site origins allowed to call this API, or * while developing
ALLOWED_ORIGINS=*

# Signs short-lived perk tokens. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Shown in the message wallets sign when opening perks
GATE_DOMAIN=loyl.local
