# Copy to .env.local for development. Everything here ships to the browser, so never put secrets in it.

# local = Anvil on 127.0.0.1:8545, sepolia = Ethereum Sepolia testnet
VITE_CHAIN=local

# From contracts/deployments/<chainId>.json after running the Deploy script
VITE_BADGE_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
VITE_BADGE_START_BLOCK=0

# Alchemy Sepolia HTTPS URL. Restrict the key to your domain in the Alchemy dashboard.
VITE_SEPOLIA_RPC_URL=

# Reown (WalletConnect) project ID, enables mobile wallets via QR. Optional for local development.
VITE_WALLETCONNECT_PROJECT_ID=

# Indexer API base path. Vite proxies /api to the local indexer; CloudFront routes it to EC2 in production.
VITE_API_URL=/api
