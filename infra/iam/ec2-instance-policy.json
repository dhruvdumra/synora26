{
  "Version": "2012-10-17",
  "Comment": "Attach to the instance role alongside the AWS managed policy AmazonSSMManagedInstanceCore. Lets the host pull its own image and ship container logs. Replace ACCOUNT_ID, REGION and ECR_REPOSITORY.",
  "Statement": [
    {
      "Sid": "PullImage",
      "Effect": "Allow",
      "Action": ["ecr:GetAuthorizationToken"],
      "Resource": "*"
    },
    {
      "Sid": "PullFromOurRepository",
      "Effect": "Allow",
      "Action": ["ecr:BatchCheckLayerAvailability", "ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer"],
      "Resource": "arn:aws:ecr:REGION:ACCOUNT_ID:repository/ECR_REPOSITORY"
    },
    {
      "Sid": "ShipLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents", "logs:DescribeLogStreams"],
      "Resource": "arn:aws:logs:REGION:ACCOUNT_ID:log-group:/loyl/*"
    }
  ]
}
