# Copy to .env (never commit .env). Foundry loads it automatically.

# Alchemy → your app → Endpoints → Ethereum Sepolia → HTTPS URL
SEPOLIA_RPC_URL=

# etherscan.io → API Keys (one key works for Sepolia too)
ETHERSCAN_API_KEY=

# Collection name shown on every badge and used in the EIP-712 signing domain.
# Choose your product name before deploying to Sepolia: it cannot be changed afterwards.
BADGE_NAME="NCrypt Pass"
BADGE_SYMBOL=NCPASS
